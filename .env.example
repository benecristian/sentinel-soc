# =====================================================================
# SENTINEL SOC — environment configuration template
# Copy to `.env` and replace every placeholder. `.env` is git-ignored.
# NEVER commit real secrets.
# =====================================================================

# --- Application ---------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = JSON logs (recommended in containers), false = human-readable console logs
LOG_JSON=false
ENABLE_API_DOCS=true

# --- Security ------------------------------------------------------
# REQUIRED. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true whenever the app is served over HTTPS.
COOKIE_SECURE=false
# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting (per client IP, per minute) ----------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=10
INGEST_RATE_LIMIT_PER_MINUTE=60
SIMULATION_RATE_LIMIT_PER_MINUTE=10

# --- Ingestion limits ----------------------------------------------
MAX_UPLOAD_MB=10
MAX_LINE_LENGTH=8192
MAX_LINES_PER_UPLOAD=100000
MAX_INGEST_BATCH=1000

# --- PostgreSQL ----------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=sentinel
# Host port for local development tools/tests (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5432

# Used by the backend when running outside Docker (local development):
DATABASE_URL=postgresql+psycopg://sentinel:replace-with-a-strong-db-password@localhost:5432/sentinel
# Used by the test-suite. The database is created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://sentinel:replace-with-a-strong-db-password@localhost:5432/sentinel_test
